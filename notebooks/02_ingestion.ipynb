    "\n",
    "\n",
    "model = RandomForestClassifier(n_estimators=100, random_state=42)\n",
    "\n",
    "print(\"Training WITHOUT external features... please wait!\")\n",
    "scores_internal = cross_val_score(\n",
    "    model, X_internal, y,\n",
    "    cv=5, scoring='f1_macro'\n",
    ")\n",
    "\n",
    "print(\"Training WITH external features... please wait!\")\n",
    "scores_full = cross_val_score(\n",
    "    model, X_full, y,\n",
    "    cv=5, scoring='f1_macro'\n",
    ")\n",
    "\n",
    "improvement = (scores_full.mean() - scores_internal.mean()) * 100\n",
    "\n",
    "print(\"=\" * 50)\n",
    "print(\"     ABLATION STUDY RESULTS\")\n",
    "print(\"=\" * 50)\n",
    "print(f\"  Without external features:\")\n",
