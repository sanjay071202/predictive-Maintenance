    "drop_cols = ['timestamp', 'Product ID', 'Type']\n",
    "df_model  = df.drop(columns=[c for c in drop_cols\n",
    "                              if c in df.columns])\n",
    "\n",
    "\n",
    "X = df_model.drop(columns=['Machine failure'])\n",
    "y = df_model['Machine failure']\n",
    "\n",
    "\n",
    "external_feature_cols = [\n",
    "    'ambient_humidity', 'wind_speed_kmh',\n",
    "    'outdoor_temp_celsius', 'factory_load_index',\n",
    "    'power_grid_voltage', 'operator_experience',\n",
    "    'shift_period', 'is_weekend',\n",
    "    'temp_difference', 'power_consumption',\n",
    "    'wear_per_rotation', 'heat_stress_index',\n",
    "    'fatigue_risk', 'hour', 'day', 'dayofweek'\n",
    "]\n",
    "\n",
    "\n",
    "X_internal = X.drop(columns=external_feature_cols)\n",
    "X_full     = X.copy()\n",
    "\n",
    "print(\"Data ready for ablation study!\")\n",
    "print(\"Internal only features :\", X_internal.shape[1])\n",
    "print(\"Full features          :\", X_full.shape[1])\n"
   ]
